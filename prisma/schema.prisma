generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  org       String   @default("")
  createdAt DateTime @default(now())

  projects  Project[]
  sessions  Session[]
  feedback  Feedback[]
}

model Agent {
  id          String   @id @default(cuid())
  name        String   @unique
  emoji       String   @default("🤖")
  description String   @default("")
  framework   String   @default("pi-coding-agent")
  version     String   @default("1.0.0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects  Project[]
  sessions  Session[]
  releases  Release[]
  issues    Issue[]
  regressionCases RegressionCase[]
  answerReviews AnswerReview[]
  /// 慢调用等非问题库条目的模型结论缓存。JSON：slot -> { hash, note }
  analysisCache String @default("")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  userId    String
  agentId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  agent     Agent    @relation(fields: [agentId], references: [id])
  sessions  Session[]

  @@index([userId])
  @@index([agentId])
}

model Session {
  id               String   @id @default(cuid())
  projectId        String
  userId           String
  agentId          String
  /// active=还在跑；waiting=已停下等人类反馈；completed=已收尾；error=已收尾且未交付
  status           String   @default("active")
  /// 会话标题：首条用户诉求截断（采集端未提供时的派生值），空串表示尚未计算
  title            String   @default("")
  /// 会话终态：success / partial / failed；空串表示未知（历史数据未回填）
  /// - success：末条 answer 成功且有输出，过程中无致命失败
  /// - partial：末条 answer 成功且有输出，但过程中出现过失败（工具重试、校验回流）
  /// - failed ：无 answer，或末条 answer 失败/空输出
  outcome          String   @default("")
  model            String   @default("")
  startTime        DateTime @default(now())
  endTime          DateTime?
  totalRounds      Int      @default(0)
  totalSpans       Int      @default(0)
  errorCount       Int      @default(0)
  /// LLM 调用次数：Span.kind='llm_thinking' 的计数。
  /// 冗余落列的原因：Session 列表与看板要按会话直接读，避免每行 JOIN 聚合 Span。
  /// 口径与详情页 header 的 LLM chip（session-detail-view.tsx 的 llmCount）一致。
  llmCallCount     Int      @default(0)
  /// 工具调用次数：Span.kind IN ('tool_call','command')。
  /// 注意包含 command（shell 命令），与 trace 前端 isToolKind 口径一致；
  /// agent-board.ts 的 toolCalls 只统计 'tool_call'，两处口径差异属历史遗留。
  toolCallCount    Int      @default(0)
  totalInputTokens Int      @default(0)
  totalOutputTokens Int     @default(0)
  totalCacheReadTokens  Int  @default(0)
  totalCacheWriteTokens Int  @default(0)
  totalTokens      Int      @default(0)
  totalDuration    Int      @default(0)
  forkCount        Int      @default(0)
  /// 父会话 id：跨进程父子链（采集端经环境变量链上报，PI_PARENT_SESSION_ID > PI_SESSION_ID 兜底）。
  /// 无外键约束——子会话可能先于父会话入库；null 表示无父/未知（含全部历史数据，不做回填）。
  parentSessionId  String?
  /// 生成本会话的父会话工具调用 span id：时间窗覆盖本会话 startTime 的 kind ∈ ('tool_call','command') Span。
  /// 无外键；由 upload route 服务端时间窗匹配填充（fill-if-empty），不回填历史。
  parentSpanId     String?
  /// 这次运行的版本指纹。空表示尚未归入任何 Release。
  releaseId        String?
  /// 首条用户话归一化后的分桶键。只用于对照，不做分类。
  taskKey          String   @default("")
  /// 这次运行被绑定到的回归用例。空表示普通会话。
  regressionCaseId String?
  rawData          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          Project  @relation(fields: [projectId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
  agent            Agent    @relation(fields: [agentId], references: [id])
  release          Release? @relation(fields: [releaseId], references: [id])
  regressionCase   RegressionCase? @relation(fields: [regressionCaseId], references: [id])
  spans            Span[]

  @@index([userId, status, startTime])
  @@index([agentId, startTime])
  @@index([projectId, startTime])
  @@index([startTime])
  @@index([parentSessionId])
  @@index([releaseId])
  @@index([agentId, taskKey])
  @@index([regressionCaseId])
}

model Release {
  id           String   @id @default(cuid())
  agentId      String
  /// sha256 前 32 位。同一 Agent 下唯一。
  fingerprint  String
  /// 人读版本号，来自 agent.json 的 version
  label        String   @default("")
  model        String   @default("")
  promptHash   String   @default("")
  skillSetHash String   @default("")
  configHash   String   @default("")
  /// reported = 带了 prompt / skill / config 哈希；weak = 只有版本号或模型
  quality      String   @default("weak")
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  agent    Agent     @relation(fields: [agentId], references: [id])
  sessions Session[]
  evidence IssueEvidence[]
  regressionRuns RegressionRun[]

  @@unique([agentId, fingerprint])
  @@index([agentId, lastSeenAt])
}

/// 跨会话的过程问题。同一 Agent 下签名唯一，不按时间窗重算。
model Issue {
  id          String   @id @default(cuid())
  agentId     String
  /// tool:{name}|err:{pattern} 或 llm|err: / answer|err: / session|no_delivery
  signature   String
  /// tool_failure | error_cluster
  kind        String
  title       String   @default("")
  /// candidate → open → confirmed / dismissed；confirmed 之后才能标 fixed
  status      String   @default("candidate")
  /// critical | warning | info。没有错误文本时封顶 info
  severity    String   @default("warning")
  hitCount    Int      @default(0)
  /// 第一条非空错误原文，给人看，不参与签名
  sampleError String   @default("")
  /// 模型对这条问题的结论。打开页面时按证据哈希复用，不重复调用。
  llmNote     String   @default("")
  llmNoteHash String   @default("")
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  agent    Agent           @relation(fields: [agentId], references: [id])
  evidence IssueEvidence[]
  regressionCase RegressionCase?
  answerReviews AnswerReview[]

  @@unique([agentId, signature])
  @@index([status, lastSeenAt])
  @@index([agentId, status])
}

model IssueEvidence {
  id        String   @id @default(cuid())
  issueId   String
  sessionId String
  /// 未交付且没有回答 span 时为空串
  spanId    String   @default("")
  releaseId String?
  /// upload | backfill
  source    String   @default("upload")
  createdAt DateTime @default(now())

  issue   Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  release Release? @relation(fields: [releaseId], references: [id])

  @@unique([issueId, sessionId, spanId])
  @@index([sessionId])
}

/// 从一条问题钉出的回归用例。平台不重新执行 Agent，只保存输入、通过标准和后来绑定的判定。
model RegressionCase {
  id              String   @id @default(cuid())
  issueId         String   @unique
  agentId         String
  sourceSessionId String
  frozenInput     String   @default("")
  passCriteria    String
  referenceOutput String   @default("")
  /// JSON 数组，元素是 evaluator id
  evaluatorIds    String   @default("[]")
  /// JSON 对象，按 evaluator id 存规则参数
  evaluatorConfig String   @default("{}")
  /// 人写的假设根因。裁判摘要写在 RegressionRun 上，两边不互相覆盖。
  hypothesis      String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  issue    Issue            @relation(fields: [issueId], references: [id])
  agent    Agent            @relation(fields: [agentId], references: [id])
  runs     RegressionRun[]
  sessions Session[]

  @@index([agentId])
}

model RegressionRun {
  id           String   @id @default(cuid())
  caseId       String
  evaluatorId  String
  sessionId    String
  releaseId    String?
  status       String   @default("pending")
  verdict      String   @default("")
  score        Float    @default(0)
  summary      String   @default("")
  evidenceJson String   @default("{}")
  errorMessage String   @default("")
  durationMs   Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  case    RegressionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  release Release?       @relation(fields: [releaseId], references: [id])

  @@unique([caseId, evaluatorId, sessionId])
  @@index([caseId])
  @@index([sessionId])
}

/// 裁判对已交付回答的抽样。确认之前不进问题库。
model AnswerReview {
  id          String   @id @default(cuid())
  agentId     String
  sessionId   String
  releaseId   String?
  evaluatorId String   @default("accuracy")
  /// pending = 等确认；confirmed = 已写入问题；dismissed = 忽略；pass = 裁判通过；skipped = 没有可评的回答
  status      String   @default("pending")
  verdict     String   @default("")
  score       Float    @default(0)
  summary     String   @default("")
  /// 裁判摘出的原文片段。确认后用它做问题签名。
  quote       String   @default("")
  issueId     String?
  createdAt   DateTime @default(now())

  agent Agent  @relation(fields: [agentId], references: [id])
  issue Issue? @relation(fields: [issueId], references: [id])

  @@unique([sessionId, evaluatorId])
  @@index([agentId, status])
}

model Skill {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String   @default("")
  skillMd      String   @default("")
  contentHash  String   @default("")
  version      Int      @default(1)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BusinessMetric {
  id           String   @id @default(cuid())
  sessionId    String
  userId       String
  projectId    String
  agentId      String
  taskId       String   @unique
  durationMs   Int      @default(0)
  success      Boolean  @default(true)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  callCount    Int      @default(0)
  models       String   @default("[]")
  customData   String?
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([agentId, createdAt])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([createdAt])
}

model Span {
  id           String   @id @default(cuid())
  sessionId    String
  roundIndex   Int      @default(0)
  turnId       Int      @default(0)
  parentId     String?
  branchId     String?
  kind         String   @default("user")
  name         String   @default("")
  status       String   @default("success")
  startTime    Int      @default(0)
  duration     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cacheReadTokens  Int  @default(0)
  cacheWriteTokens Int  @default(0)
  totalTokens  Int      @default(0)
  model        String?
  input        String?
  output       String?
  error        String?
  llmThinkDuration    Int?
  agentReplyDuration  Int?
  toolDuration        Int?
  details     String?
  content     String?
  isForkPoint  Boolean  @default(false)
  createdAt    DateTime @default(now())

  session      Session  @relation(fields: [sessionId], references: [id], onDelete:Cascade)

  @@index([sessionId, roundIndex, turnId])
  @@index([parentId])
  @@index([branchId])
  @@index([name, createdAt])
  // 统计接口按 Span 活动时间跨会话过滤（/api/stats、/api/agents/stats、trend 等），
  // 无单列索引时是全表扫；分桶循环里会重复扫，数据量上去后是主要瓶颈
  @@index([createdAt])
}

model Experiment {
  id               String   @id @default(cuid())
  userId           String
  name             String
  type             String   @default("single")
  agentId          String
  evaluatorIdsJson String   @default("[]")
  evaluatorConfigJson String @default("{}")
  status           String   @default("draft")
  scope            String   @default("")
  watchMode        Boolean  @default(false)
  watchEnabledAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cases            ExperimentCase[]
  comments         ExperimentEvalComment[]

  @@index([userId, createdAt])
  @@index([agentId])
  @@index([watchMode, agentId])
}

model ExperimentCase {
  id                   String   @id @default(cuid())
  experimentId         String
  experiment           Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  sessionId            String?
  input                String   @default("")
  actualOutput         String   @default("")
  referenceOutput      String?
  evaluatorContextJson String?
  createdAt            DateTime @default(now())

  results              ExperimentEvalResult[]

  @@index([experimentId])
  @@index([sessionId])
}

model ExperimentEvalResult {
  id           String   @id @default(cuid())
  experimentId String
  caseId       String
  case         ExperimentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evaluatorId  String
  status       String   @default("pending")
  verdict      String?
  summary      String?
  score        Float?
  pointsJson   String?
  evidenceJson String?
  humanScore   Float?
  humanReason  String?
  humanBy      String?
  humanAt      DateTime?
  errorMessage String?
  attempts     Int      @default(0)
  durationMs   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([caseId, evaluatorId])
  @@index([experimentId, evaluatorId])
}

model ExperimentEvalComment {
  id           String   @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  caseId       String?
  resultId     String?
  user         String
  body         String
  createdAt    DateTime @default(now())

  @@index([experimentId, createdAt])
  @@index([caseId, createdAt])
  @@index([resultId, createdAt])
}

/// 一次实时异常的持久记录。同一签名反复出现只更新次数，消失后标为已恢复。
model AlertEvent {
  id         String    @id @default(cuid())
  type       String
  severity   String
  /// error / agent_error:{names} / token / activity_drop
  signature  String    @unique
  message    String    @default("")
  /// open | resolved
  status     String    @default("open")
  hitCount   Int       @default(1)
  detailJson String    @default("[]")
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  resolvedAt  DateTime?

  @@index([status, lastSeenAt])
}

/// 新打开的告警要推到哪里。地址是一个接收 JSON 的 webhook。
model AlertRule {
  id          String    @id @default(cuid())
  name        String
  enabled     Boolean   @default(true)
  /// warning = 警告和严重都推；critical = 只推严重
  minSeverity String    @default("warning")
  /// JSON 数组。空数组表示全部类型。
  typesJson   String    @default("[]")
  target      String    @default("")
  lastSentAt  DateTime?
  lastError   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// 点赞、点踩、问题上报。采集端和会话页都写到这里。
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  sessionId String   @default("")
  agentId   String   @default("")
  /// up | down | report
  kind      String
  body      String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([sessionId])
}

model UserSettings {
  id           String   @id @default(cuid())
  user         String   @unique
  settingsJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


